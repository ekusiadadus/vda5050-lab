+void CFootBotDiffusion::queueVdaActionBatch(const SIM_PLAN &actions) {
+    if (actions.empty() || !vda_pending_batch_id.empty()) {
+        return;
+    }
+    ++vda_batch_counter;
+    std::ostringstream id;
+    id << robot_id << "-" << std::setw(6) << std::setfill('0')
+       << vda_batch_counter;
+    vda_pending_batch_id = id.str();
+    vda_pending_actions = json::array();
+    for (const auto &action : actions) {
+        const auto start = get<4>(action);
+        const auto end = get<5>(action);
+        const int orientation = static_cast<int>(get<2>(action));
+        if (orientation < 0 || orientation > 3) {
+            throw std::runtime_error("invalid LSMART orientation");
+        }
+        vda_pending_actions.push_back(
+            {{"node_id", get<1>(action)},
+             {"kind", vdaKind(get<3>(action))},
+             {"start",
+              {ChangeCoordinateFromMapToArgos(get<1>(start)),
+               ChangeCoordinateFromMapToArgos(get<0>(start))}},
+             {"end",
+              {ChangeCoordinateFromMapToArgos(get<1>(end)),
+               ChangeCoordinateFromMapToArgos(get<0>(end))}},
+             {"orientation", orientation},
+             {"task_id", get<6>(action)}});
+    }
+    const json envelope = {
+        {"schema", "vda5050-lab.lsmart-action-batch/1"},
+        {"run_id", vda_bridge_run_id},
+        {"batch_id", vda_pending_batch_id},
+        {"robot_id", robot_id},
+        {"simulation_tick", step_count_},
+        {"actions", vda_pending_actions},
+    };
+    atomicWriteJson(std::filesystem::path(vda_bridge_dir) / "outbox" /
+                        (vda_pending_batch_id + ".json"),
+                    envelope);
+}
+
+void CFootBotDiffusion::acceptVdaDelivery() {
+    if (vda_pending_batch_id.empty()) {
+        return;
+    }
+    const auto path = std::filesystem::path(vda_bridge_dir) / "inbox" /
+                      (vda_pending_batch_id + ".json");
+    if (!std::filesystem::is_regular_file(path)) {
+        return;
+    }
+    std::ifstream input(path);
+    json delivery;
+    input >> delivery;
+    if (delivery.value("schema", "") !=
+            "vda5050-lab.lsmart-delivery/1" ||
+        delivery.value("status", "") != "mqtt-delivered" ||
+        delivery.value("run_id", "") != vda_bridge_run_id ||
+        delivery.value("batch_id", "") != vda_pending_batch_id ||
+        delivery.value("robot_id", "") != robot_id ||
+        !delivery.contains("actions") ||
+        delivery["actions"] != vda_pending_actions) {
+        throw std::runtime_error("VDA bridge delivery does not match batch");
+    }
+    insertVdaActions(delivery["actions"]);
+    vda_current_order_id = delivery.value("order_id", "");
+    vda_pending_batch_id.clear();
+    vda_pending_actions = json::array();
+}
+
+void CFootBotDiffusion::insertVdaActions(const json &actions) {
+    for (const auto &action : actions) {
+        const auto end = action.at("end");
+        const double x = end.at(0).get<double>();
+        const double y = end.at(1).get<double>();
+        const int orientation = action.at("orientation").get<int>();
+        const int node_id = action.at("node_id").get<int>();
+        const int task_id = action.at("task_id").get<int>();
+        const string kind = action.at("kind").get<string>();
+        const double angle = orientationDegrees(orientation);
+        if (kind == "MOVE") {
+            deque<int> previous_ids;
+            if (!q.empty() && q.back().type == Action::MOVE) {
+                previous_ids = q.back().nodeIDS;
+                q.pop_back();
+            }
+            previous_ids.push_back(node_id);
+            q.emplace_back(x, y, angle, previous_ids, Action::MOVE);
+        } else if (kind == "TURN") {
+            q.emplace_back(x, y, angle, deque<int>{node_id}, Action::TURN);
+        } else if (kind == "STATION") {
+            q.emplace_back(x, y, angle, deque<int>{node_id}, Action::STATION,
+                           DELIVER_T, task_id);
+        } else {
+            throw std::runtime_error("invalid action in VDA delivery");
+        }
+    }
+}
+
+void CFootBotDiffusion::pollVdaBridge() {
+    if (vda_bridge_dir.empty()) {
+        if (count % 10 == 0) {
+            const auto actions =
+                client->call("obtain_actions", robot_id).as<SIM_PLAN>();
+            if (!actions.empty()) {
+                insertActions(actions);
+            }
+        }
+        return;
+    }
+    acceptVdaDelivery();
+    if (count % 10 == 0 && vda_pending_batch_id.empty()) {
+        const auto actions =
+            client->call("obtain_actions", robot_id).as<SIM_PLAN>();
+        if (!actions.empty()) {
+            queueVdaActionBatch(actions);
+        }
+    }
+}
+
+string CFootBotDiffusion::reportFinishedNode(int node_id) {
+    vda_last_finished_node_id = node_id;
+    return client->call("receive_update", robot_id, node_id).as<string>();
+}
+
+void CFootBotDiffusion::writeVdaTelemetry(const CVector3 &position, Real angle,
+                                          const Action &action,
+                                          Real left_velocity,
+                                          Real right_velocity) {
+    if (vda_bridge_dir.empty()) {
+        return;
+    }
+    string motion_state = "WAITING";
+    if (action.type == Action::MOVE) {
+        motion_state = "DRIVING";
+    } else if (action.type == Action::TURN) {
+        motion_state = "TURNING";
+    } else if (action.type == Action::STATION) {
+        motion_state = "STATION";
+    }
+    const json telemetry = {
+        {"schema", "vda5050-lab.lsmart-pose/1"},
+        {"robot_id", robot_id},
+        {"simulation_tick", step_count_},
+        {"x", position.GetX()},
+        {"y", position.GetY()},
+        {"theta", angle * M_PI / 180.0},
+        {"linear_velocity", (left_velocity + right_velocity) / 2.0},
+        {"angular_velocity", (right_velocity - left_velocity) / 0.14},
+        {"motion_state", motion_state},
+        {"last_node_id",
+         vda_last_finished_node_id < 0 ? json(nullptr)
+                                       : json(vda_last_finished_node_id)},
+        {"order_id",
+         vda_current_order_id.empty() ? json(nullptr)
+                                      : json(vda_current_order_id)},
+    };
+    atomicWriteJson(std::filesystem::path(vda_bridge_dir) / "telemetry" /
+                        (robot_id + ".json"),
+                    telemetry);
+}
