+void atomicWriteJson(const std::filesystem::path &target,
+                     const json &payload) {
+    const auto temporary = target.string() + ".tmp";
+    {
+        std::ofstream output(temporary, std::ios::out | std::ios::trunc);
+        if (!output.is_open()) {
+            throw std::runtime_error("cannot open VDA bridge temporary file");
+        }
+        output << payload.dump() << std::endl;
+        output.flush();
+        if (!output.good()) {
+            throw std::runtime_error("cannot write VDA bridge temporary file");
+        }
+    }
+    std::filesystem::rename(temporary, target);
+}
+
+string vdaKind(const string &action) {
+    if (action == "M") {
+        return "MOVE";
+    }
+    if (action == "T") {
+        return "TURN";
+    }
+    if (action == "S") {
+        return "STATION";
+    }
+    throw std::runtime_error("unknown LSMART action for VDA bridge");
+}
+
+double orientationDegrees(int orientation) {
+    if (orientation == 0) {
+        return 0.0;
+    }
+    if (orientation == 1) {
+        return 270.0;
+    }
+    if (orientation == 2) {
+        return 180.0;
+    }
+    if (orientation == 3) {
+        return 90.0;
+    }
+    throw std::runtime_error("invalid LSMART orientation for VDA bridge");
+}
+
+}  // namespace
